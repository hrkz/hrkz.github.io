---
import { getCollection } from "astro:content";
import { sortByDate } from "../scripts/utils";

import Page from "../components/Page.astro";
import Entry from "../components/Entry.astro";

const notes = sortByDate(await getCollection("notes"));
---

<Page page='Hugo Frezat "hrkz"' , site="Simulating Nature">
  <img class="page__banner" src="/assets/banner.jpg" />
  <div class="page__block">
    <section class="container page__hero">
      <h1>Hugo Frezat <i>"hrkz"</i></h1>
      <span>
        I am a researcher exploring the intersection of statistical machine
        learning and numerical simulation for dynamical systems derived from
        differential equations. My primary focus is on climate-related systems
        (oceans, atmosphere) and astrophysical fluid dynamics (planetary
        interiors, geodynamo, etc.), though I am always open to new
        applications.
      </span>
      <span>
        I [plan to] occasionally share notes on a variety of topics I come
        across in my research, ranging from theorems and numerical simulations
        to physics phenomena or computer science stuff.
      </span>
      <h3>Information</h3>
      <span>
        ⚠️ This website has been built from scratch but some sections are still
        missing. I am working on filling the gaps and this will lead to some
        updates soon.
      </span>
    </section>
  </div>

  <div class="page__block">
    <section class="container">
      <div class="section__title">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24px"
          height="24px"
          fill="currentColor"
        >
          <path
            d="M11 19.425v-6.85L5 9.1v6.85zm2 0l6-3.475V9.1l-6 3.475zm-1-8.575l5.925-3.425L12 4L6.075 7.425zM4 17.7q-.475-.275-.737-.725t-.263-1v-7.95q0-.55.263-1T4 6.3l7-4.025Q11.475 2 12 2t1 .275L20 6.3q.475.275.738.725t.262 1v7.95q0 .55-.262 1T20 17.7l-7 4.025Q12.525 22 12 22t-1-.275zm8-5.7"
          ></path>
        </svg>
        <span>Projects</span>
      </div>
      <div class="project-list">
        <div class="card">
          <img src="https://placehold.co/400x300/png" class="card__image" />
          <div class="card__content">
            <a href="/projects#given" class="card__link"><h4>Given</h4></a>
            <p>Symbolic reasoning and computations with equivalence graphs.</p>
            <a href="https://github.com/hrkz/given" class="card__source">
              <span>Source</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="24px"
                height="24px"
                fill="currentColor"
              >
                <path
                  d="m9.6 15.6l1.4-1.425L8.825 12L11 9.825L9.6 8.4L6 12zm4.8 0L18 12l-3.6-3.6L13 9.825L15.175 12L13 14.175zM5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.587 1.413T19 21zm0-2h14V5H5zM5 5v14z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
        <div class="card">
          <img src="https://placehold.co/400x300/png" class="card__image" />
          <div class="card__content">
            <a href="/projects#vario" class="card__link"><h4>Vario</h4></a>
            <p>
              High-order differentiable solvers for conservation laws using JAX.
            </p>
            <a href="#" class="card__source">
              <span>Source</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="24px"
                height="24px"
                fill="currentColor"
              >
                <path
                  d="m9.6 15.6l1.4-1.425L8.825 12L11 9.825L9.6 8.4L6 12zm4.8 0L18 12l-3.6-3.6L13 9.825L15.175 12L13 14.175zM5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.587 1.413T19 21zm0-2h14V5H5zM5 5v14z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
        <div class="card">
          <img src="https://placehold.co/400x300/png" class="card__image" />
          <div class="card__content">
            <a href="/projects#lore" class="card__link"><h4>lore-lang</h4></a>
            <p>Functional array-based language for numerical computations.</p>
            <a href="#" class="card__source">
              <span>Source</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="24px"
                height="24px"
                fill="currentColor"
              >
                <path
                  d="m9.6 15.6l1.4-1.425L8.825 12L11 9.825L9.6 8.4L6 12zm4.8 0L18 12l-3.6-3.6L13 9.825L15.175 12L13 14.175zM5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.587 1.413T19 21zm0-2h14V5H5zM5 5v14z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="page__block">
    <section class="container">
      {
        notes.length > 0 && (
          <>
            <div class="section__title">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="24px"
                height="24px"
                fill="currentColor"
              >
                <path d="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h11l5 5v11q0 .825-.587 1.413T19 21zm0-2h14V9h-4V5H5zm2-2h10v-2H7zm0-8h5V7H7zm0 4h10v-2H7zM5 5v4zv14z" />
              </svg>
              <span>Recent notes</span>
            </div>
            <ul>
              {notes.map(
                ({ id, data }, i) =>
                  i < 4 && <Entry id={id} frontmatter={data} />,
              )}
            </ul>
          </>
        )
      }

      <div class="notes__footer">
        <a href="/notes/" class="notes__btn">Read more notes</a>
      </div>
    </section>
  </div>

  <div class="page__block">
    <section class="container">
      <div class="section__title">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24px"
          height="24px"
          fill="currentColor"
        >
          <path
            d="M14 9.9V8.2q.825-.35 1.688-.525T17.5 7.5q.65 0 1.275.1T20 7.85v1.6q-.6-.225-1.213-.337T17.5 9q-.95 0-1.825.238T14 9.9m0 5.5v-1.7q.825-.35 1.688-.525T17.5 13q.65 0 1.275.1t1.225.25v1.6q-.6-.225-1.213-.338T17.5 14.5q-.95 0-1.825.225T14 15.4m0-2.75v-1.7q.825-.35 1.688-.525t1.812-.175q.65 0 1.275.1T20 10.6v1.6q-.6-.225-1.213-.338T17.5 11.75q-.95 0-1.825.238T14 12.65M6.5 16q1.175 0 2.288.263T11 17.05V7.2q-1.025-.6-2.175-.9T6.5 6q-.9 0-1.788.175T3 6.7v9.9q.875-.3 1.738-.45T6.5 16m6.5 1.05q1.1-.525 2.213-.787T17.5 16q.9 0 1.763.15T21 16.6V6.7q-.825-.35-1.713-.525T17.5 6q-1.175 0-2.325.3T13 7.2zM12 20q-1.2-.95-2.6-1.475T6.5 18q-1.05 0-2.062.275T2.5 19.05q-.525.275-1.012-.025T1 18.15V6.1q0-.275.138-.525T1.55 5.2q1.15-.6 2.4-.9T6.5 4q1.45 0 2.838.375T12 5.5q1.275-.75 2.663-1.125T17.5 4q1.3 0 2.55.3t2.4.9q.275.125.413.375T23 6.1v12.05q0 .575-.487.875t-1.013.025q-.925-.5-1.937-.775T17.5 18q-1.5 0-2.9.525T12 20m-5-8.35"
          ></path>
        </svg>
        <span>Teaching</span>
      </div>
      In progress...
    </section>
  </div>

  <div class="page__block">
    <section class="container">
      <div class="section__title">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24px"
          height="24px"
          fill="currentColor"
        >
          <path
            d="m12 23l-3-3H5q-.825 0-1.412-.587T3 18V4q0-.825.588-1.412T5 2h14q.825 0 1.413.588T21 4v14q0 .825-.587 1.413T19 20h-4zm-7-6.15q1.35-1.325 3.138-2.087T12 14t3.863.763T19 16.85V4H5zm9.475-5.875Q15.5 9.95 15.5 8.5t-1.025-2.475T12 5T9.525 6.025T8.5 8.5t1.025 2.475T12 12t2.475-1.025M7 18h10v-.25q-1.05-.875-2.325-1.312T12 16t-2.675.438T7 17.75zm3.938-8.437Q10.5 9.125 10.5 8.5t.438-1.062T12 7t1.063.438T13.5 8.5t-.437 1.063T12 10t-1.062-.437m1.062.862"
          ></path>
        </svg>
        <span>CV</span>
      </div>
      In progress...
    </section>
  </div>
</Page>

<style>
  .page__banner {
    max-height: 300px;
    object-fit: cover;
    border-bottom: 4px solid var(--color-text);
  }

  .page__block:nth-child(even) {
    background-color: var(--color-surface);
  }

  .section__title {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: calc(0.1 * var(--base-size));
    padding-block: calc(0.2 * var(--base-size));
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* hero section */
  .page__hero {
    display: flex;
    flex-direction: column;
    row-gap: 18px;
    margin-block: calc(0.5 * var(--base-size));
  }

  /* projects section */
  .project-list {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(calc(var(--base-size)), 1fr)
    );
    gap: calc(0.25 * var(--base-size));

    .card {
      min-height: 420px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      overflow: hidden;
      background-color: var(--color-background);
      border: 1px solid rgb(from var(--color-text-alt) r g b / 0.3);
      border-radius: 8px;
      transition: all 0.3s ease;

      &:hover {
        box-shadow:
          0 4px 8px 3px rgba(0, 0, 0, 0.15),
          0 1px 3px 0 rgba(0, 0, 0, 0.3);
      }

      .card__image {
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: 8px 8px 0 0;
      }

      .card__content {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: calc(0.4 * var(--base-size));

        .card__link {
          text-transform: uppercase;
          text-overflow: ellipsis;
          font-weight: 500;
        }

        .card__source {
          display: flex;
          align-items: center;
          justify-content: space-between;
        }
      }
    }
  }

  @media (max-width: 768px) {
    .project-list {
      grid-template-columns: 1fr;
    }
  }

  /* recent-notes section */
  .notes__footer {
    margin-top: calc(0.25 * var(--base-size));

    .notes__btn {
      display: block;
      width: calc(3 * var(--base-size));
      padding-block: calc(0.1 * var(--base-size));
      margin: auto;
      text-align: center;
      border: 1px solid var(--color-text-alt);
      border-radius: 48px;

      &:hover {
        border-color: var(--color-text);
        background-color: rgb(from var(--color-primary) r g b / 0.1);
      }
    }
  }
</style>
