<style>
  footer {
    margin-top: auto;
    padding-block: 36px;
    background-color: var(--color-surface);

    .nav-block {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-bottom: 24px;

      .nav-block__category {
        font-weight: 500;
        text-transform: uppercase;
      }

      .nav-block__list {
        margin-top: 12px;
      }
    }

    @media (max-width: 768px) {
      .nav-block {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }
    }

    .footer__link {
      color: var(--color-text-alt);

      &:hover {
        color: var(--color-text);
      }
    }

    .socials-list {
      display: flex;
      flex-direction: row;
      gap: 12px;
      width: 100%;
      margin-block: 24px 6px;
    }
  }
</style>
