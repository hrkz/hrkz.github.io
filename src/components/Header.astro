---
import Search from "../components/Search.astro";

const { page } = Astro.props;
---

<header>
  <input type="checkbox" id="rail__btn" />
  <label for="rail__btn" class="header__icon header__btn header__btn--close">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="24px"
      height="24px"
    >
      <path
        d="M3 18v-2h13v2zm16.6-1l-5-5l5-5L21 8.4L17.4 12l3.6 3.6zM3 13v-2h10v2zm0-5V6h13v2z"
      ></path>
    </svg>
  </label>
  <label for="rail__btn" class="header__icon header__btn header__btn--open">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="24px"
      height="24px"
    >
      <path d="M3 18v-2h18v2zm0-5v-2h18v2zm0-5V6h18v2z"></path>
    </svg>
  </label>
  <img class="header__logo" src="/assets/avatar.jpg" alt="" />
  <a href="/" class="header__link"
    ><span class="header__title">Sim. Nat.</span></a
  >
  <nav class="nav-bar">
    <a
      href="/about/"
      class=`header__link ${page === 'About' ? 'active-page' : ''}`>About</a
    >
    <a
      href="/research/"
      class=`header__link ${page === 'Research' ? 'active-page' : ''}`
      >Research</a
    >
    <a
      href="/projects/"
      class=`header__link ${page === 'Projects' ? 'active-page' : ''}`
      >Projects</a
    >
    <a
      href="/notes/"
      class=`header__link ${page === 'Notes' ? 'active-page' : ''}`>Notes</a
    >
  </nav>

  <div class="header__actions">
    <Search />
    <a
      class="header__icon"
      target="_blank"
      href="/rss.xml"
      aria-label="RSS feed"
      title="RSS Feed"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="24px"
        height="24px"
      >
        <path
          d="M3.588 20.413Q3 19.825 3 19t.588-1.412T5 17t1.413.588T7 19t-.587 1.413T5 21t-1.412-.587M17 21q0-2.925-1.1-5.462t-3-4.438t-4.437-3T3 7V4q3.55 0 6.625 1.325t5.4 3.65t3.65 5.4T20 21zm-6 0q0-1.675-.625-3.113T8.65 15.35t-2.537-1.725T3 13v-3q2.3 0 4.288.863t3.487 2.362t2.363 3.488T14 21z"
        ></path>
      </svg>
    </a>
  </div>

  <aside class="nav-rail">
    <hr />
    <a
      href="/about/"
      class=`header__link ${page === 'About' ? 'active-page' : ''}`
    >
      <label class="header__btn">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24px"
          height="24px"
          fill="currentColor"
        >
          <path
            fill="currentColor"
            d="M11 17h2v-6h-2zm1.713-8.287Q13 8.425 13 8t-.288-.712T12 7t-.712.288T11 8t.288.713T12 9t.713-.288M12 22q-2.075 0-3.9-.788t-3.175-2.137T2.788 15.9T2 12t.788-3.9t2.137-3.175T8.1 2.788T12 2t3.9.788t3.175 2.137T21.213 8.1T22 12t-.788 3.9t-2.137 3.175t-3.175 2.138T12 22m0-2q3.35 0 5.675-2.325T20 12t-2.325-5.675T12 4T6.325 6.325T4 12t2.325 5.675T12 20m0-8"
          ></path>
        </svg>
      </label>
      <span class="nav-rail__item">About</span>
    </a>
    <a
      href="/research/"
      class=`header__link ${page === 'Research' ? 'active-page' : ''}`
    >
      <label class="header__btn">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24px"
          height="24px"
          fill="currentColor"
        >
          <path
            d="m18 20.5l-4-4l4-4l1.4 1.4l-1.575 1.6H22v2h-4.175l1.575 1.6zM4 20q-.825 0-1.412-.587T2 18v-3q0-.825.588-1.412T4 13h6q.825 0 1.413.588T12 15v3q0 .825-.587 1.413T10 20zm0-2h6v-3H4zm2-6.5l-1.4-1.4l1.575-1.6H2v-2h4.175L4.6 4.9L6 3.5l4 4zm8-.5q-.825 0-1.412-.587T12 9V6q0-.825.588-1.412T14 4h6q.825 0 1.413.588T22 6v3q0 .825-.587 1.413T20 11zm0-2h6V6h-6zm-4 9v-3zm4-9V6z"
          ></path>
        </svg>
      </label>
      <span class="nav-rail__item">Research</span>
    </a>
    <a
      href="/projects/"
      class=`header__link ${page === 'Projects' ? 'active-page' : ''}`
    >
      <label class="header__btn">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24px"
          height="24px"
          fill="currentColor"
        >
          <path
            d="M11 19.425v-6.85L5 9.1v6.85zm2 0l6-3.475V9.1l-6 3.475zm-1-8.575l5.925-3.425L12 4L6.075 7.425zM4 17.7q-.475-.275-.737-.725t-.263-1v-7.95q0-.55.263-1T4 6.3l7-4.025Q11.475 2 12 2t1 .275L20 6.3q.475.275.738.725t.262 1v7.95q0 .55-.262 1T20 17.7l-7 4.025Q12.525 22 12 22t-1-.275zm8-5.7"
          ></path>
        </svg>
      </label>
      <span class="nav-rail__item">Projects</span>
    </a>
    <a
      href="/notes/"
      class=`header__link ${page === 'Notes' ? 'active-page' : ''}`
    >
      <label class="header__btn">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24px"
          height="24px"
          fill="currentColor"
        >
          <path
            d="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h11l5 5v11q0 .825-.587 1.413T19 21zm0-2h14V9h-4V5H5zm2-2h10v-2H7zm0-8h5V7H7zm0 4h10v-2H7zM5 5v4zv14z"
          ></path>
        </svg>
      </label>
      <span class="nav-rail__item">Notes</span>
    </a>
  </aside>
  <label for="rail__btn" class="overlay"></label>
</header>

<style>
  :global(header) {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    height: 64px;
    padding-inline: 16px;
    align-items: center;
    background-color: var(--color-background);
    box-shadow:
      0 2px 5px 0 rgba(0, 0, 0, 0.15),
      0 2px 5px 0 rgba(0, 0, 0, 0.25);
    z-index: 10;

    input {
      display: none;
    }

    .header__icon {
      cursor: pointer;
      align-items: center;
      fill: var(--color-text-alt);

      &:hover {
        fill: var(--color-text);
      }
    }

    .header__btn {
      display: none;
      margin-right: 24px;
    }

    .header__link {
      display: flex;
      padding-block: 8px;
      font-size: 1rem;
      color: var(--color-text-alt);

      &:hover {
        color: var(--color-text);
      }
    }

    .header__logo {
      width: 40px;
      height: 40px;
      border-radius: calc(infinity * 1px);
      margin-right: 24px;
      z-index: 110;
    }

    .header__title {
      font-size: 1.25rem;
      z-index: 110;
    }

    .active-page {
      color: var(--color-text);
    }

    /* nav bar (desktop) */
    .nav-bar {
      display: flex;
      align-items: end;
      margin-left: 50px;

      .active-page {
        border-bottom: 2px solid var(--color-primary);
      }

      .header__link {
        margin-top: 5px;
        padding-inline: 24px;

        &:hover {
          background-color: var(--color-surface);
        }
      }
    }

    .header__actions {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-left: auto;
    }

    /* rail nav (tablet and mobile) */
    .nav-rail {
      position: fixed;
      top: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      width: 350px;
      height: 100%;
      padding-top: 64px;
      background-color: var(--color-background);
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      z-index: 100;

      hr {
        padding-bottom: 24px;
      }

      .header__link:hover,
      .active-page {
        background-color: var(--color-surface);
      }

      .header__link {
        align-items: center;
        padding-inline: 32px;
        padding-block: 16px;
        border-start-end-radius: 100px;
        border-end-end-radius: 100px;

        .nav-rail__item {
          font-size: 1rem;
        }
      }
    }

    /* opened rail */
    #rail__btn:checked ~ .nav-rail {
      transform: translateX(0);
    }

    #rail__btn:checked ~ .overlay {
      opacity: 0.5;
      pointer-events: auto;
    }

    #rail__btn:checked ~ .header__btn--open {
      display: none;
    }

    #rail__btn:checked ~ .header__btn--close {
      display: flex;
      z-index: 110;
    }

    .overlay {
      position: fixed;
      inset: 0;
      background: var(--color-text-alt);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      z-index: 99;
    }

    @media (max-width: 1024px) {
      .header__btn {
        display: flex;
      }

      .nav-bar,
      .header__btn--close {
        display: none;
      }
    }
  }
</style>
